# The Arch unit-test, parity and PKGBUILD image, the second sibling of
# .github/ci/Dockerfile.  Arch is the one distro whose own xdotool is the
# version this project clones -- 4.20260303.1, the same build the nix-pinned
# oracle is -- so tests/test_cli_parity.py compares real bytes here and the
# `parity-arch` job of ci.yml exists for exactly that [recon2/pkg-arch.md].
#
# Arch is rolling, and until 2026-09-12 that was the reason every job running in
# this image was `continue-on-error` in ci.yml: `pacman -Syu` at build time
# resolved against whatever the mirrors held that hour, so a package moving under
# an unchanged Dockerfile could turn a push red for nothing to do with the push.
# Both halves are pinned now instead of excused:
#
#   * the base image is a DATED tag pinned by digest.  ci.yml passes it as BASE
#     out of its `image` matrix and its `plan` step hashes it INTO the image key
#     beside this file, because the cached image is named after that key: a
#     digest bumped without it would find the old tag and build nothing.  The
#     ARG default below is that same reference, so a `docker build` by hand gets
#     the image CI got; tests/test_ci_images.py compares the two;
#   * every `pacman -Sy` goes to an archive.archlinux.org SNAPSHOT of the same
#     date rather than to a live mirror, so `pacman -Syu` resolves to the same
#     bytes today and in six months.
#
# The snapshot and the base tag move together, by hand, and their date is the one
# number to change.  Measured in the 2026/09/06 snapshot on 2026-09-12: xdotool
# 4.20260303.1 (the generation tests/test_cli_parity.py is written against -- this
# image exists for that), wmctrl 1.07-6 whose `--help` is 6801 bytes (byte for byte
# nixpkgs' plain 1.07, which is what scripts/parity-oracle.sh gates on), sway
# 1:1.12-4, python 3.14.7, xorg-xwayland 24.1.13.
#
# The recon measured `python3 -m unittest discover -s tests` at 234.6 s for
# 3163 tests in an Arch chroot [recon2/pkg-arch.md].  The unit-distro job runs
# the same files one process at a time rather than under discover, which costs
# 105 interpreter startups (1.0 s in total, measured) and buys the isolation
# `unit` has on every Ubuntu release; its budget is 90 minutes, because this
# image has sway and Xvfb in it and the chroot had neither.
#
# labwc, wayfire, i3 and openbox stay out for the same reason as in
# Dockerfile.fedora: the live compositor files run on the Ubuntu image, and there
# only on the releases whose packages are the measured versions.
ARG BASE=archlinux:base-devel-20260906.0.587075@sha256:61f7de2dd88cc4ba1fe36c24cfe1a503c3936984492d6405eeab013ce6ac68c5
FROM ${BASE}
ARG NODE=v22.22.1
#: the archive.archlinux.org snapshot every sync in this file resolves against.
#: Same date as the base tag above: a snapshot OLDER than the image would make
#: `pacman -Syu` a downgrade and a newer one a partial upgrade, and both are
#: shapes nobody wants to debug from a CI log.
ARG ARCH_SNAPSHOT=2026/09/06
ENV LANG=C.UTF-8
# The mirrorlist first, then one full upgrade against it: `-Syu` and not `-Sy`,
# because a sync that installs new packages beside un-upgraded ones is Arch's
# classic breakage.  Against a frozen mirror the upgrade is deterministic, which
# is the whole point of the two pins.
RUN printf 'Server = https://archive.archlinux.org/repos/%s/$repo/os/$arch\n' "${ARCH_SNAPSHOT}" \
        > /etc/pacman.d/mirrorlist \
    && cat /etc/pacman.d/mirrorlist
RUN pacman-key --init && pacman -Syu --noconfirm --needed \
        python python-gobject gtk3 gtk4 \
        sway xorg-xwayland xterm foot xorg-server-xvfb xorg-xauth \
        xorg-xprop xorg-xrandr xdotool wmctrl \
        dbus glib2 gobject-introspection \
        namcap python-build python-installer python-wheel python-setuptools acl \
        curl xz zstd git procps-ng sudo \
    && pacman -Scc --noconfirm
# sway ships with cap_sys_nice in its file capabilities on this distro, and a container whose
# bounding set lacks it refuses to exec the binary at all (EPERM from execve, run 34360974165);
# the headless sway the live tests start needs no capability, so the file loses it here.
RUN setcap -r /usr/bin/sway 2>/dev/null || true
# the image's pacman.conf keeps documentation out (NoExtract), and `pacman -Qkk` then
# reports the package's /usr/share/doc as an altered file (CI run 34369384290)
RUN sed -i '/^NoExtract/d' /etc/pacman.conf
# nodejs-lts-jod IS 22 today, but it is a rolling package name and
# tests/test_bridge_js.py was written against one build; the tarball is the same
# node on all three images and costs nothing to keep the same.
RUN curl -fsSL "https://nodejs.org/dist/${NODE}/node-${NODE}-linux-x64.tar.xz" | tar -xJ -C /opt \
    && ln -s "/opt/node-${NODE}-linux-x64/bin/node" /usr/local/bin/node && node --version
# uid 1000 as on the other two images (SUDO_UID=1000 in the sudo fixtures), and
# NOPASSWD sudo because makepkg REFUSES to run as root: the pkgbuild job is the
# one job here that cannot be root even for a moment.
RUN if getent passwd 1000 >/dev/null; then userdel -r "$(getent passwd 1000 | cut -d: -f1)"; fi \
    && useradd -m -u 1000 -s /bin/bash ci \
    && install -d -m 0700 -o ci -g ci /tmp/xdg-ci \
    && echo 'ci ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/ci
# the directory X servers and the xw11 proxy bind their filesystem socket in: on a real
# system the first X server creates it 1777 as root; a container has no such first server
RUN install -d -m 1777 /tmp/.X11-unix
