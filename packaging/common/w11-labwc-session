#!/bin/sh
# w11 instrumented labwc session.  AGENTS.md route 6, our code, unmodified labwc:
# preload w11's geometry shim into the stock compositor and exec it, so a native
# Wayland toplevel's on-screen rectangle reaches wdotool/wwmctl over the file the
# shim writes ($XDG_RUNTIME_DIR/w11-labwc-geometry).  The distro's labwc and
# libwlroots stay bit-for-bit what the distro ships; nothing here patches them.
#
#     w11-labwc-session labwc            # the /usr/share/wayland-sessions entry
#     w11-labwc-session budgie-wm ...    # or any labwc-backed session's launcher
#
# The shim is a .so compiled against the target's own libwlroots (the only
# version whose ABI it can correctly read), so it is built ON the target, not
# baked into the Architecture: all package.  This wrapper uses the system .so if
# the package built one at install time, else builds it once into the user's
# cache from the shipped source.  Either way it exec's the compositor even when
# the shim is unavailable -- a session that comes up without the extra geometry
# beats a session that does not come up.
set -u

# The directory this wrapper and the shim's source live in -- /usr/lib/w11 on the
# .deb and the PKGBUILD, /usr/libexec/w11 on the rpm -- resolved from the script's
# own path so the same bytes work wherever the packaging installed it.  W11_LIBDIR
# overrides it (the test rig, or an odd layout).
libdir=${W11_LIBDIR:-$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)}
so_system="$libdir/w11-labwc-shim.so"
srcdir="$libdir/labwc-shim"

cache=${XDG_CACHE_HOME:-$HOME/.cache}/w11
so_user="$cache/w11-labwc-shim.so"

so=""
if [ -e "$so_system" ]; then
    so="$so_system"
elif [ -e "$srcdir/build-shim.sh" ]; then
    # Build (or rebuild if the source is newer) into the per-user cache.
    if [ ! -e "$so_user" ] || [ "$srcdir/w11-labwc-shim.c" -nt "$so_user" ]; then
        mkdir -p "$cache" 2>/dev/null || true
        sh "$srcdir/build-shim.sh" "$srcdir/w11-labwc-shim.c" "$so_user" \
            >"$cache/build.log" 2>&1 || true
    fi
    [ -e "$so_user" ] && so="$so_user"
fi

if [ -n "$so" ]; then
    if [ -n "${LD_PRELOAD:-}" ]; then
        LD_PRELOAD="$so:$LD_PRELOAD"
    else
        LD_PRELOAD="$so"
    fi
    export LD_PRELOAD
fi

exec "$@"
