#!/usr/bin/make -f
# Built with pybuild: the six commands, their entry points and the version all
# come from pyproject.toml, so there is one place to change any of them.  The
# packages are pure stdlib (warandr imports the system PyGObject at run time,
# which is a Depends, not a vendored copy), so the ordinary Debian layout --
# /usr/lib/python3/dist-packages plus generated console scripts -- needs no
# private directory and no bundled anything.

export PYBUILD_NAME=w11

%:
	dh $@ --with python3 --buildsystem=pybuild

# The test suite drives real compositors, VMs and /dev/uinput (see tests/ and
# vm/README.md); none of that exists in a build chroot.
override_dh_auto_test:

execute_after_dh_install:
# Renamed on the way in: modules-load.d wants the file named for what installs
# it, and the autostart entry is namespaced by the package.  The autostart
# entry itself lands under /usr/lib and reaches /etc/xdg/autostart as the
# symlink in debian/w11.links: debhelper registers every regular file
# under /etc as a conffile, and a conffile survives `apt remove` -- an entry
# left behind pointing at a helper that removal has just deleted.  A symlink is
# not a conffile, so it goes when the package goes.
#
# The enabler and its .desktop come from packaging/common/, not from here: a
# per-user gsettings enable and an XDG autostart entry are needed identically
# by the .deb, the rpm and the PKGBUILD, and an Arch recipe reaching into a
# directory named for dpkg was the thing that said they were in the wrong
# place.  Same bytes, one copy; the rpm rewrites only the .desktop's Exec=,
# because /usr/libexec is where Fedora puts the helper.
	install -D -m 644 gnome/modules-load-uinput.conf \
	    debian/w11/usr/lib/modules-load.d/w11-uinput.conf
	install -D -m 755 packaging/common/enable-bridge \
	    debian/w11/usr/lib/w11/enable-bridge
	install -D -m 644 packaging/common/enable-bridge.desktop \
	    debian/w11/usr/lib/w11/enable-bridge.desktop
