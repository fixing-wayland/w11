<?xml version="1.0"?>
<!-- GENERATED by gnome/overlap-typelib/gen-gir.py -- do not edit by hand.
     Mutter 17's private monitor-configuration structures, described so that no
     pointer in them is ever followed by the type system.  See that script.

     NO shared-library, and that is deliberate (0.4, measured on GNOME 51): a
     description here is a *layout*, not a binding to one file name.  A
     shared-library attribute makes GIRepository dlopen exactly that file, and
     a forced run on a new GNOME picks a description by struct size -- so the
     file name inside it is the one thing already known to be wrong, and
     libmutter-18.so.0 is not there on a machine carrying libmutter-51.so.0.
     The dlopen fails, and gjs then *aborts the process* on the first call
     through the description (assertion ffi_arg_pos == ffi_argc), which on
     Wayland is the whole session.  With no shared-library the symbols resolve
     out of gnome-shell's own global scope, where libmutter already is, and a
     symbol that is genuinely missing throws catchably instead.  Which library
     is mapped is proved from /proc/self/maps by the extension, which is where
     a file name belongs. -->
<repository version="1.2"
            xmlns="http://www.gtk.org/introspection/core/1.0"
            xmlns:c="http://www.gtk.org/introspection/c/1.0"
            xmlns:glib="http://www.gtk.org/introspection/glib/1.0">
  <include name="GObject" version="2.0"/>
  <namespace name="W11Overlap17" version="1.0"
             c:identifier-prefixes="Meta" c:symbol-prefixes="meta">

    <!-- MetaMonitorsConfig.  Every pointer is a guint64: a number, never a
         dereference. -->
    <record name="ConfigN" c:type="MetaMonitorsConfigN">
      <field name="g_class" writable="1"><type name="guint64" c:type="guint64"/></field>
      <field name="ref_count" writable="1"><type name="guint64" c:type="guint64"/></field>
      <field name="qdata" writable="1"><type name="guint64" c:type="guint64"/></field>
      <field name="parent_config" writable="1"><type name="guint64" c:type="guint64"/></field>
      <field name="key" writable="1"><type name="guint64" c:type="guint64"/></field>
      <field name="logical_monitor_configs" writable="1"><type name="guint64" c:type="guint64"/></field>
      <field name="disabled_monitor_specs" writable="1"><type name="guint64" c:type="guint64"/></field>
      <field name="u56" writable="1"><type name="gint" c:type="gint"/></field>
      <field name="u60" writable="1"><type name="gint" c:type="gint"/></field>
      <field name="u64" writable="1"><type name="gint" c:type="gint"/></field>
      <field name="layout_mode" writable="1"><type name="gint" c:type="gint"/></field>
      <field name="switch_config" writable="1"><type name="gint" c:type="gint"/></field>
      <field name="tail_pad" writable="1"><type name="gint" c:type="gint"/></field>
    </record>

    <!-- GList -->
    <record name="NodeN" c:type="MetaNodeN">
      <field name="data" writable="1"><type name="guint64" c:type="guint64"/></field>
      <field name="next" writable="1"><type name="guint64" c:type="guint64"/></field>
      <field name="prev" writable="1"><type name="guint64" c:type="guint64"/></field>
    </record>

    <!-- MetaLogicalMonitorConfig.  x is at +0 and y at +4: the only two words
         this extension ever writes. -->
    <record name="LMCN" c:type="MetaLMCN">
      <field name="x" writable="1"><type name="gint" c:type="gint"/></field>
      <field name="y" writable="1"><type name="gint" c:type="gint"/></field>
      <field name="width" writable="1"><type name="gint" c:type="gint"/></field>
      <field name="height" writable="1"><type name="gint" c:type="gint"/></field>
      <field name="monitor_configs" writable="1"><type name="guint64" c:type="guint64"/></field>
      <field name="transform" writable="1"><type name="gint" c:type="gint"/></field>
      <field name="scale" writable="1"><type name="gfloat" c:type="gfloat"/></field>
      <field name="is_primary" writable="1"><type name="gboolean" c:type="gboolean"/></field>
      <field name="is_presentation" writable="1"><type name="gboolean" c:type="gboolean"/></field>
    </record>

    <!-- MetaMonitorConfig -->
    <record name="MCN" c:type="MetaMCN">
      <field name="monitor_spec" writable="1"><type name="guint64" c:type="guint64"/></field>
      <field name="mode_spec" writable="1"><type name="guint64" c:type="guint64"/></field>
      <field name="enable_underscanning" writable="1"><type name="gint" c:type="gint"/></field>
      <field name="pad" writable="1"><type name="gint" c:type="gint"/></field>
    </record>

    <!-- MetaMonitorSpec -->
    <record name="MSN" c:type="MetaMSN">
      <field name="connector" writable="1"><type name="guint64" c:type="guint64"/></field>
      <field name="vendor" writable="1"><type name="guint64" c:type="guint64"/></field>
      <field name="product" writable="1"><type name="guint64" c:type="guint64"/></field>
      <field name="serial" writable="1"><type name="guint64" c:type="guint64"/></field>
    </record>

    <function name="dup_cfg" c:identifier="g_memdup2">
      <return-value transfer-ownership="none"><type name="ConfigN" c:type="gpointer"/></return-value>
      <parameters>
        <parameter name="mem" transfer-ownership="none"><type name="guint64" c:type="guint64"/></parameter>
        <parameter name="n" transfer-ownership="none"><type name="guint64" c:type="gsize"/></parameter>
      </parameters>
    </function>
    <function name="dup_node" c:identifier="g_memdup2">
      <return-value transfer-ownership="none"><type name="NodeN" c:type="gpointer"/></return-value>
      <parameters>
        <parameter name="mem" transfer-ownership="none"><type name="guint64" c:type="guint64"/></parameter>
        <parameter name="n" transfer-ownership="none"><type name="guint64" c:type="gsize"/></parameter>
      </parameters>
    </function>
    <function name="dup_lmc" c:identifier="g_memdup2">
      <return-value transfer-ownership="none"><type name="LMCN" c:type="gpointer"/></return-value>
      <parameters>
        <parameter name="mem" transfer-ownership="none"><type name="guint64" c:type="guint64"/></parameter>
        <parameter name="n" transfer-ownership="none"><type name="guint64" c:type="gsize"/></parameter>
      </parameters>
    </function>
    <function name="dup_mc" c:identifier="g_memdup2">
      <return-value transfer-ownership="none"><type name="MCN" c:type="gpointer"/></return-value>
      <parameters>
        <parameter name="mem" transfer-ownership="none"><type name="guint64" c:type="guint64"/></parameter>
        <parameter name="n" transfer-ownership="none"><type name="guint64" c:type="gsize"/></parameter>
      </parameters>
    </function>
    <function name="dup_ms" c:identifier="g_memdup2">
      <return-value transfer-ownership="none"><type name="MSN" c:type="gpointer"/></return-value>
      <parameters>
        <parameter name="mem" transfer-ownership="none"><type name="guint64" c:type="guint64"/></parameter>
        <parameter name="n" transfer-ownership="none"><type name="guint64" c:type="gsize"/></parameter>
      </parameters>
    </function>
    <!-- a bounded copy of at most n bytes of a string.  g_strndup returns
         freshly allocated memory, so the caller owns it: declared "none" the
         string was converted to a JS value and then leaked, one connector name
         per monitor per read. -->
    <function name="strn" c:identifier="g_strndup">
      <return-value transfer-ownership="full"><type name="utf8" c:type="char*"/></return-value>
      <parameters>
        <parameter name="s" transfer-ownership="none"><type name="guint64" c:type="guint64"/></parameter>
        <parameter name="n" transfer-ownership="none"><type name="guint64" c:type="gsize"/></parameter>
      </parameters>
    </function>

    <!-- the address of an object, as a number (g_object_ref returns its argument);
         every addr() is balanced by an unref_addr() -->
    <function name="addr" c:identifier="g_object_ref">
      <return-value transfer-ownership="none"><type name="guint64" c:type="guint64"/></return-value>
      <parameters><parameter name="o" transfer-ownership="none"><type name="GObject.Object" c:type="gpointer"/></parameter></parameters>
    </function>
    <function name="unref_addr" c:identifier="g_object_unref">
      <return-value transfer-ownership="none"><type name="none" c:type="void"/></return-value>
      <parameters><parameter name="p" transfer-ownership="none"><type name="guint64" c:type="gpointer"/></parameter></parameters>
    </function>

    <!-- reads offset 0 only; GTypeInstance's first word is frozen ABI -->
    <function name="type_name" c:identifier="g_type_name_from_instance">
      <return-value transfer-ownership="none"><type name="utf8" c:type="char*"/></return-value>
      <parameters><parameter name="o" transfer-ownership="none"><type name="GObject.Object" c:type="gpointer"/></parameter></parameters>
    </function>

    <!-- the exported-but-not-introspected monitor configuration API -->
    <function name="get_config_manager" c:identifier="meta_monitor_manager_get_config_manager">
      <return-value transfer-ownership="none"><type name="GObject.Object" c:type="gpointer"/></return-value>
      <parameters><parameter name="m" transfer-ownership="none"><type name="GObject.Object" c:type="gpointer"/></parameter></parameters>
    </function>
    <function name="get_current" c:identifier="meta_monitor_config_manager_get_current">
      <return-value transfer-ownership="none"><type name="GObject.Object" c:type="gpointer"/></return-value>
      <parameters><parameter name="c" transfer-ownership="none"><type name="GObject.Object" c:type="gpointer"/></parameter></parameters>
    </function>
    <function name="create_linear" c:identifier="meta_monitor_config_manager_create_linear">
      <return-value transfer-ownership="full"><type name="GObject.Object" c:type="gpointer"/></return-value>
      <parameters><parameter name="c" transfer-ownership="none"><type name="GObject.Object" c:type="gpointer"/></parameter></parameters>
    </function>
    <function name="get_switch_config" c:identifier="meta_monitors_config_get_switch_config">
      <return-value transfer-ownership="none"><type name="gint" c:type="gint"/></return-value>
      <parameters><parameter name="c" transfer-ownership="none"><type name="GObject.Object" c:type="gpointer"/></parameter></parameters>
    </function>
    <function name="set_switch_config" c:identifier="meta_monitors_config_set_switch_config">
      <return-value transfer-ownership="none"><type name="none" c:type="void"/></return-value>
      <parameters><parameter name="c" transfer-ownership="none"><type name="GObject.Object" c:type="gpointer"/></parameter>
                  <parameter name="v" transfer-ownership="none"><type name="gint" c:type="gint"/></parameter></parameters>
    </function>
    <function name="verify" c:identifier="meta_verify_monitors_config" throws="1">
      <return-value transfer-ownership="none"><type name="gboolean" c:type="gboolean"/></return-value>
      <parameters><parameter name="c" transfer-ownership="none"><type name="GObject.Object" c:type="gpointer"/></parameter>
                  <parameter name="m" transfer-ownership="none"><type name="GObject.Object" c:type="gpointer"/></parameter></parameters>
    </function>
    <function name="apply" c:identifier="meta_monitor_manager_apply_monitors_config" throws="1">
      <return-value transfer-ownership="none"><type name="gboolean" c:type="gboolean"/></return-value>
      <parameters><parameter name="m" transfer-ownership="none"><type name="GObject.Object" c:type="gpointer"/></parameter>
                  <parameter name="c" transfer-ownership="none"><type name="GObject.Object" c:type="gpointer"/></parameter>
                  <parameter name="method" transfer-ownership="none"><type name="gint" c:type="gint"/></parameter></parameters>
    </function>

    <!-- the write: four bytes at an address the reader has already range-checked -->
    <function name="wr" c:identifier="memcpy">
      <return-value transfer-ownership="none"><type name="guint64" c:type="gpointer"/></return-value>
      <parameters>
        <parameter name="dest" transfer-ownership="none"><type name="guint64" c:type="gpointer"/></parameter>
        <parameter name="src" transfer-ownership="none">
          <array c:type="gpointer" length="2"><type name="guint8" c:type="guint8"/></array>
        </parameter>
        <parameter name="n" transfer-ownership="none"><type name="guint64" c:type="gsize"/></parameter>
      </parameters>
    </function>
  </namespace>
</repository>
